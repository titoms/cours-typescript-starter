{
  "name": "hello-ts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "dts": "tsc --declaration --emitDeclarationOnly --outDir types",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('types',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "typescript": "5.9.3"
  }
}
